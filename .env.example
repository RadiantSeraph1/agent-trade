# Placeholders only. Copy to .env (git-ignored). Never commit real values.
FXLAB_MODE=replay                 # replay | paper_live | synthetic
FXLAB_DB_URL=sqlite:///data/fxlab.db
FXLAB_AI_MODE=off                 # off | mock | vertex
FXLAB_AI_DAILY_BUDGET_USD=1.00
FXLAB_AI_MONTHLY_BUDGET_USD=15.00
FXLAB_AI_KILL_SWITCH=false

# Vertex AI (optional; uses Application Default Credentials)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
FXLAB_AI_MODEL=                   # verify available model id before use

# Live market data provider (optional)
FXLAB_DATA_PROVIDER=
FXLAB_DATA_API_KEY=
